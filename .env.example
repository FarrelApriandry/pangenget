# Neon Postgres Serverless Connection String
# Dapatkan url connection string dari dashboard https://console.neon.tech
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon Managed Better Auth
NEON_AUTH_BASE_URL="https://YOUR_AUTH_ENDPOINT.neonauth.c-5.aws.neon.tech/neondb/auth"
PUBLIC_NEON_AUTH_URL="https://YOUR_AUTH_ENDPOINT.neonauth.c-5.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://YOUR_AUTH_ENDPOINT.neonauth.c-5.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# Telegram Bot Notification
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
CRON_SECRET="YOUR_CRON_SECRET_KEY"

# Server configuration
PORT=4321
HOST=0.0.0.0
