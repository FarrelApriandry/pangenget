---
import "../styles/global.css";
import { Navbar } from "../components/Navbar";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Pangenget — Fokus, Kerjakan, Bereskan",
  description = "Aplikasi To-Do List terstruktur berbasis Astro 5 SSR dan Neon Serverless PostgreSQL."
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>
  <body class="bg-[#f7f8f4] dark:bg-[#161a12] text-[#333d29] dark:text-[#f5f7f1] flex flex-col min-h-screen">
    <Navbar client:load siteName="Pangenget" currentPath={currentPath} />

    <main class="flex-1 pb-24 sm:pb-16">
      <slot />
    </main>

    <footer class="border-t border-[#d5dcce] dark:border-[#333d29] py-6 text-center text-xs text-[#656d4a] dark:text-[#bcc7a6] mt-auto hidden sm:block">
      <div class="w-full px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <span class="font-semibold text-[#333d29] dark:text-[#f5f7f1]">Pangenget</span>
          <span>&bull;</span>
          <span>Fokus, Kerjakan, Bereskan.</span>
        </div>
        <div class="flex items-center gap-4">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#e8ecde] dark:bg-[#20261b] text-[#333d29] dark:text-[#d3dbc3] text-[11px] font-medium border border-[#d3dbc3] dark:border-[#333d29]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#656d4a] dark:bg-[#a4ac86] animate-pulse"></span>
            Neon Serverless Connected
          </span>
          <a href="/landing-page/" class="hover:underline font-semibold text-[#656d4a] dark:text-[#a4ac86]">Landing Page</a>
          <a href="/api/tasks" target="_blank" class="hover:underline">API Tasks</a>
        </div>
      </div>
    </footer>
  </body>
</html>
